{
  "name": "whatzmcp",
  "version": "0.1.0",
  "description": "Open source WhatsApp MCP server. Connect your own WhatsApp account to Claude and other AI assistants. Runs on your machine.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.whatzmcp/whatzmcp",
  "bin": {
    "whatzmcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "contract/door-contract.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatzmcp/whatzmcp.git"
  },
  "homepage": "https://whatzmcp.com",
  "bugs": {
    "url": "https://github.com/whatzmcp/whatzmcp/issues"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "whatsapp-mcp",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "ai-assistant",
    "baileys",
    "self-hosted"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "12.11.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  }
}
